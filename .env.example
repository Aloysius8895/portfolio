# Set these in Vercel > Project > Settings > Environment Variables.
# Do not paste secrets into the admin form, source files, commits or chat.
PUBLIC_BASE_URL=https://your-portfolio.vercel.app
ADMIN_GITHUB_ID=your-numeric-github-user-id
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# Fine-grained token: ONLY your portfolio repository, Contents read/write,
# Commit statuses read. No access to all repositories is needed.
GITHUB_TOKEN=your-restricted-portfolio-token
PORTFOLIO_REPOSITORY=your-account/your-portfolio-repository
PORTFOLIO_BRANCH=main
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
